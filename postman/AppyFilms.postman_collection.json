      "name": "Crear",
      "item": [
        {
          "name": "Crear película de prueba",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Película creada\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n    const movie = pm.response.json();\r\n    pm.collectionVariables.set(\"movieId\", movie.id);\r\n    pm.collectionVariables.set(\"movieTitle\", movie.title);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"title\": \"Prueba CRUD {{$timestamp}}\",\r\n    \"duration\": 100,\r\n    \"genre\": \"COMEDY\",\r\n    \"releaseDate\": \"2020-01-01\",\r\n    \"rating\": 4.0\r\n}",
              "options": {
